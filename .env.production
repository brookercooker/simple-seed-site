# Not a secret file: these are Supabase's publishable/anon values, explicitly designed to be
# exposed client-side (see src/lib/supabaseClient.ts). Committing them directly sidesteps the
# build-time-vs-runtime env var confusion documented in pipeline-test-plan.md -- Cloudflare's
# "Variables and Secrets" dashboard turned out to only set runtime Worker bindings (via
# wrangler.jsonc's `vars`), not values available to `vite build` itself. Vite loads .env files
# automatically at build time regardless of any Cloudflare dashboard configuration, which is a
# more reliable mechanism for this specific case.
VITE_SUPABASE_URL=https://vhdrooartoyogqoxmrmf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__0REYz3-NtpXeYfhkblirA_UObABcR1
